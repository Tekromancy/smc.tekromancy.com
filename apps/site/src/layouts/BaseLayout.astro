---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Silent Mode Control | Custom Android Call Screening & Schedules",
  description = "Granular ringer, vibration, and silent schedules per contact and group for Android. 100% on-device, zero tracking.",
  ogImage = "/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-mode="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Theme script to prevent FOUC -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme-mode');
      if (savedTheme) {
        document.documentElement.setAttribute('data-mode', savedTheme);
      } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
        document.documentElement.setAttribute('data-mode', 'light');
      } else {
        document.documentElement.setAttribute('data-mode', 'dark');
      }
    </script>

    <!-- Google Analytics (GA4) -->
    {import.meta.env.PUBLIC_GA_MEASUREMENT_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ gaId: import.meta.env.PUBLIC_GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- Google AdSense / Ads -->
    {import.meta.env.PUBLIC_ADSENSE_CLIENT_ID && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT_ID}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body class="min-h-screen flex flex-col antialiased selection:bg-purple-600 selection:text-white">
    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 backdrop-blur-md border-b" style="background-color: rgba(var(--color-surface), 0.85); border-color: var(--color-border);">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center space-x-3 group">
          <img src="/icons/app-logo.svg" alt="Silent Mode Control Logo" class="w-10 h-10 rounded-xl shadow-md transition-transform group-hover:scale-105" />
          <div>
            <div class="font-bold text-base tracking-tight flex items-center gap-1.5" style="color: var(--color-text-primary);">
              Silent Mode Control
              <span class="text-[10px] uppercase font-extrabold px-1.5 py-0.5 rounded tracking-wider text-white" style="background-color: var(--color-primary);">v1.0</span>
            </div>
            <div class="text-[11px] font-medium" style="color: var(--color-text-secondary);">by Tekromancy</div>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center space-x-6 text-sm font-medium">
          <a href="/#features" class="hover:opacity-80 transition-opacity" style="color: var(--color-text-secondary);">Features</a>
          <a href="/#timeline" class="hover:opacity-80 transition-opacity" style="color: var(--color-text-secondary);">24h Timeline</a>
          <a href="/#compare" class="hover:opacity-80 transition-opacity" style="color: var(--color-text-secondary);">Free vs Pro</a>
          <a href="/blog" class="hover:opacity-80 transition-opacity" style="color: var(--color-text-secondary);">News & Blog</a>
          <a href="/privacy" class="hover:opacity-80 transition-opacity" style="color: var(--color-text-secondary);">Privacy Policy</a>
        </nav>

        <!-- Right Side Actions: Theme Toggle + CTA -->
        <div class="flex items-center space-x-3">
          <!-- Theme Toggle Button -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle Light and Dark Mode"
            class="p-2 rounded-lg border transition-colors hover:opacity-80 cursor-pointer"
            style="border-color: var(--color-border); background-color: var(--color-surface-elevated);"
          >
            <!-- Sun Icon (shown in dark mode) -->
            <svg id="theme-icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4" stroke-width="2" />
              <path stroke-width="2" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14l-1.41 1.41" />
            </svg>
            <!-- Moon Icon (shown in light mode) -->
            <svg id="theme-icon-moon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

          <a
            href="https://play.google.com/apps/testing/com.tekromancy.silentmodecontrol"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden md:inline-flex items-center space-x-1.5 text-xs font-bold uppercase tracking-wider px-3.5 py-2 rounded-xl border border-yellow-500/40 text-yellow-300 bg-yellow-500/10 shadow-sm transition-all hover:scale-105 hover:bg-yellow-500/20"
          >
            <span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></span>
            <span>Join Closed Beta</span>
          </a>

          <a
            href="https://play.google.com/store/apps/details?id=com.tekromancy.silentmodecontrol"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center space-x-2 text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-xl text-white shadow-md transition-all hover:scale-105 hover:opacity-95"
            style="background: linear-gradient(135deg, #9333ea, #7e22ce);"
          >
            <span>Google Play</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t mt-20 pt-12 pb-16" style="border-color: var(--color-border); background-color: var(--color-surface);">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
          <div class="md:col-span-2 space-y-3">
            <div class="flex items-center space-x-2.5">
              <img src="/icons/app-logo.svg" alt="Silent Mode Control Logo" class="w-8 h-8 rounded-lg shadow-sm" />
              <span class="font-bold text-lg" style="color: var(--color-text-primary);">Silent Mode Control</span>
            </div>
            <p class="text-sm max-w-sm" style="color: var(--color-text-secondary);">
              Granular call screening and schedule rules for Android. 100% on-device execution, zero cloud servers, zero trackers.
            </p>
            <div class="text-xs font-mono pt-1" style="color: var(--color-text-muted);">
              Hosted on smc.tekromancy.com
            </div>
          </div>

          <div>
            <h3 class="text-xs font-extrabold uppercase tracking-wider mb-3" style="color: var(--color-text-primary);">Application</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/#features" class="hover:underline" style="color: var(--color-text-secondary);">Key Features</a></li>
              <li><a href="/#timeline" class="hover:underline" style="color: var(--color-text-secondary);">24-Hour Timeline</a></li>
              <li><a href="/#compare" class="hover:underline" style="color: var(--color-text-secondary);">Free vs Pro Edition</a></li>
              <li><a href="https://play.google.com/store/apps/details?id=com.tekromancy.silentmodecontrol" class="hover:underline" style="color: var(--color-text-secondary);" target="_blank" rel="noopener">Google Play Store</a></li>
            </ul>
          </div>


          <div>
            <h3 class="text-xs font-extrabold uppercase tracking-wider mb-3" style="color: var(--color-text-primary);">Resources & Legal</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/blog" class="hover:underline" style="color: var(--color-text-secondary);">Releases & News</a></li>
              <li><a href="/privacy" class="hover:underline" style="color: var(--color-text-secondary);">Privacy Policy</a></li>
              <li><a href="https://github.com/tekromancy/SilentModeControl" class="hover:underline" style="color: var(--color-text-secondary);" target="_blank" rel="noopener">GitHub Repository</a></li>
              <li><a href="https://tekromancy.com" class="hover:underline" style="color: var(--color-text-secondary);" target="_blank" rel="noopener">Tekromancy Home</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t pt-6 flex flex-col sm:flex-row justify-between items-center text-xs" style="border-color: var(--color-border); color: var(--color-text-secondary);">
          <p>&copy; {new Date().getFullYear()} Tekromancy. All rights reserved.</p>
          <p class="mt-2 sm:mt-0">Designed with the Tekromancy design token system.</p>
        </div>
      </div>
    </footer>

    <!-- Client Script for Theme Switcher -->
    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      const sun = document.getElementById('theme-icon-sun');
      const moon = document.getElementById('theme-icon-moon');

      function updateIcons(mode) {
        if (mode === 'dark') {
          sun?.classList.remove('hidden');
          moon?.classList.add('hidden');
        } else {
          sun?.classList.add('hidden');
          moon?.classList.remove('hidden');
        }
      }

      const initialMode = document.documentElement.getAttribute('data-mode') || 'dark';
      updateIcons(initialMode);

      toggle?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-mode') || 'dark';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-mode', next);
        localStorage.setItem('theme-mode', next);
        updateIcons(next);
      });
    </script>
  </body>
</html>
