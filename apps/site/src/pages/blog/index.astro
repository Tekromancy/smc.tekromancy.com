---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="News & Releases | Silent Mode Control"
  description="Stay updated with latest feature updates, release notes, and engineering guides for Silent Mode Control."
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 pt-12 pb-20">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider mb-4 border" style="background-color: var(--color-surface-elevated); border-color: var(--color-border); color: var(--color-primary);">
        Tekromancy Newsroom
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4" style="color: var(--color-text-primary);">
        News, Updates & Guides
      </h1>
      <p class="text-base sm:text-lg" style="color: var(--color-text-secondary);">
        Explore release notes, architecture insights, and tutorials for Silent Mode Control on Android.
      </p>
    </div>

    <div class="space-y-6">
      {posts.map((post) => (
        <article class="p-6 sm:p-8 rounded-2xl border transition-all hover:scale-[1.01] hover:shadow-lg relative group" style="background-color: var(--color-surface); border-color: var(--color-border);">
          <div class="flex flex-wrap items-center gap-3 text-xs mb-3" style="color: var(--color-text-muted);">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
            <span>•</span>
            <span>By {post.data.author}</span>
            {post.data.featured && (
              <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider text-white" style="background-color: var(--color-primary);">
                Featured
              </span>
            )}
          </div>

          <h2 class="text-xl sm:text-2xl font-bold mb-3 transition-colors group-hover:text-purple-400" style="color: var(--color-text-primary);">
            <a href={`/blog/${post.id}`} class="focus:outline-none">
              <span class="absolute inset-0" aria-hidden="true" />
              {post.data.title}
            </a>
          </h2>

          <p class="text-sm leading-relaxed mb-6" style="color: var(--color-text-secondary);">
            {post.data.description}
          </p>

          <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t" style="border-color: var(--color-border);">
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="text-xs px-2.5 py-1 rounded-md font-medium border" style="background-color: var(--color-surface-elevated); border-color: var(--color-border); color: var(--color-text-secondary);">
                  #{tag}
                </span>
              ))}
            </div>

            <span class="text-xs font-bold inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform" style="color: var(--color-primary);">
              Read Article &rarr;
            </span>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
