---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-16 sm:pt-24 pb-20 border-b" style="border-color: var(--color-border); background: radial-gradient(circle at 50% 0%, rgba(147, 51, 234, 0.15) 0%, transparent 70%);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
      <!-- App Icon Visual Badge -->
      <div class="flex justify-center mb-6">
        <div class="relative group">
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-purple-600 to-indigo-600 opacity-50 blur-lg group-hover:opacity-75 transition duration-500"></div>
          <img src="/icons/app-logo.svg" alt="Silent Mode Control" class="relative w-24 h-24 sm:w-28 sm:h-28 rounded-3xl shadow-2xl transition-transform duration-300 group-hover:scale-105" />
        </div>
      </div>

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-8 border shadow-sm" style="background-color: var(--color-surface); border-color: var(--color-border); color: var(--color-primary);">
        <span class="w-2 h-2 rounded-full animate-pulse" style="background-color: var(--color-primary);"></span>
        Native Android Telecom Call Screening
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight max-w-4xl mx-auto leading-tight mb-6" style="color: var(--color-text-primary);">
        Take Absolute Control Over When Your Phone <span class="bg-gradient-to-r from-purple-400 via-purple-300 to-indigo-300 bg-clip-text text-transparent">Rings or Silences</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl max-w-2xl mx-auto mb-10 leading-relaxed" style="color: var(--color-text-secondary);">
        Silent Mode Control empowers you with granular ringer, vibration, and mute schedules for individual numbers and contact groups. <strong>100% on-device processing. Zero tracking.</strong>
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
        <a
          href="#beta"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl font-extrabold text-sm uppercase tracking-wider text-black shadow-xl transition-all hover:scale-105 hover:opacity-95 flex items-center justify-center gap-3 border border-yellow-400/80"
          style="background: linear-gradient(135deg, #fef08a, #eab308);"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-black animate-ping"></span>
          <span>⚡ Join Closed Beta (3 Quick Steps)</span>
        </a>

        <a
          href="https://play.google.com/store/apps/details?id=com.tekromancy.silentmodecontrol"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl font-extrabold text-sm uppercase tracking-wider text-white shadow-xl transition-all hover:scale-105 hover:opacity-95 flex items-center justify-center gap-3"
          style="background: linear-gradient(135deg, #9333ea, #6b21a8);"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M3.609 1.814L13.792 12 3.61 22.186a1.99 1.99 0 0 1-.61-.92L3 2.734c0-.36.09-.68.609-.92zm11.597 11.597l2.87 2.87-12.7 7.28 9.83-10.15zm0-2.822L5.376.439l12.7 7.28-2.87 2.87zm1.414 1.411l3.52 2.02c.86.49.86 1.3 0 1.79l-3.52 2.02-2.43-2.43 2.43-2.4v-1z"/>
          </svg>
          <span>Google Play Store</span>
        </a>

        <a
          href="#compare"
          class="w-full sm:w-auto px-7 py-4 rounded-2xl font-bold text-sm tracking-wider border transition-all hover:scale-105 flex items-center justify-center gap-2"
          style="background-color: var(--color-surface); border-color: var(--color-border); color: var(--color-text-primary);"
        >
          <span class="text-purple-400">★</span>
          <span>Pro Edition</span>
          <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full border border-purple-500/40 text-purple-300 bg-purple-500/10">Coming Soon</span>
        </a>
      </div>

      <!-- Closed Testing Help Notice -->
      <div class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs border mb-12" style="background-color: rgba(234, 179, 8, 0.08); border-color: rgba(234, 179, 8, 0.3); color: var(--color-text-secondary);">
        <span class="text-yellow-400 font-bold">Closed Beta Live:</span>
        <span>Google Group access is active! Join <a href="https://groups.google.com/g/tekromancy" target="_blank" rel="noopener noreferrer" class="underline font-semibold" style="color: var(--color-primary);">tekromancy@googlegroups.com</a> for instant enrollment, or follow the <a href="#beta" class="underline font-semibold" style="color: var(--color-primary);">3-step guide below</a>.</span>
      </div>

      <!-- Trust Badges -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto pt-6 border-t text-xs font-semibold" style="border-color: var(--color-border); color: var(--color-text-secondary);">
        <div class="flex items-center justify-center gap-1.5">
          <span class="text-green-400">✓</span> Android 10+ Compatible
        </div>
        <div class="flex items-center justify-center gap-1.5">
          <span class="text-green-400">✓</span> 100% On-Device Only
        </div>
        <div class="flex items-center justify-center gap-1.5">
          <span class="text-green-400">✓</span> Zero Cloud Trackers
        </div>
        <div class="flex items-center justify-center gap-1.5">
          <span class="text-green-400">✓</span> Overnight Schedules
        </div>
      </div>
    </div>
  </section>

  <!-- Dedicated Closed Beta 3-Step Enrollment Section -->
  <section id="beta" class="py-16 sm:py-20 border-b relative" style="border-color: var(--color-border); background: radial-gradient(circle at 50% 50%, rgba(234, 179, 8, 0.06) 0%, transparent 70%), var(--color-surface-elevated);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4 border shadow-sm" style="background-color: var(--color-surface); border-color: rgba(234, 179, 8, 0.4); color: #eab308;">
          <span class="w-2 h-2 rounded-full bg-yellow-400 animate-ping"></span>
          Official Google Play Closed Beta
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4" style="color: var(--color-text-primary);">
          Join the Closed Beta in 3 Quick Steps
        </h2>
        <p class="text-base sm:text-lg" style="color: var(--color-text-secondary);">
          Google Play requires testers to be enrolled before downloading pre-release apps. Follow these 3 quick steps to gain instant access without waiting:
        </p>
      </div>

      <!-- 3-Step Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <!-- Step 1 -->
        <div class="p-6 sm:p-8 rounded-2xl border flex flex-col justify-between relative transition-all hover:scale-[1.02] shadow-lg" style="background-color: var(--color-surface); border-color: var(--color-border);">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="w-9 h-9 rounded-xl font-extrabold text-sm flex items-center justify-center text-black shadow-sm" style="background: linear-gradient(135deg, #fef08a, #eab308);">1</span>
              <span class="text-xs font-semibold px-2 py-0.5 rounded border border-yellow-500/40 text-yellow-400 bg-yellow-500/10">Required First</span>
            </div>
            <h3 class="text-xl font-bold mb-2" style="color: var(--color-text-primary);">Join Google Group</h3>
            <p class="text-xs sm:text-sm mb-6 leading-relaxed" style="color: var(--color-text-secondary);">
              Join our official tester group with the Google account you use on your Android phone. This automatically whitelists your account on Google Play.
            </p>
          </div>
          <div>
            <a
              href="https://groups.google.com/g/tekromancy"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3 rounded-xl font-bold text-xs uppercase tracking-wider text-center text-black shadow-md transition-all hover:opacity-95 flex items-center justify-center gap-2 border border-yellow-400/80"
              style="background: linear-gradient(135deg, #fef08a, #eab308);"
            >
              <span>1. Join Google Group</span>
              <span class="text-sm">↗</span>
            </a>
            <div class="text-[11px] text-center mt-2 font-mono" style="color: var(--color-text-muted);">
              tekromancy@googlegroups.com
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="p-6 sm:p-8 rounded-2xl border flex flex-col justify-between relative transition-all hover:scale-[1.02] shadow-lg" style="background-color: var(--color-surface); border-color: var(--color-border);">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="w-9 h-9 rounded-xl font-extrabold text-sm flex items-center justify-center text-white shadow-sm" style="background: linear-gradient(135deg, #9333ea, #6b21a8);">2</span>
              <span class="text-xs font-semibold px-2 py-0.5 rounded border border-purple-500/40 text-purple-300 bg-purple-500/10">Web Opt-in</span>
            </div>
            <h3 class="text-xl font-bold mb-2" style="color: var(--color-text-primary);">Accept Tester Invite</h3>
            <p class="text-xs sm:text-sm mb-6 leading-relaxed" style="color: var(--color-text-secondary);">
              Open the Google Play opt-in portal and click the blue <strong>"Become a Tester"</strong> button. Make sure you are signed into the same Google account.
            </p>
          </div>
          <div>
            <a
              href="https://play.google.com/apps/testing/com.tekromancy.silentmodecontrol"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3 rounded-xl font-bold text-xs uppercase tracking-wider text-center text-white shadow-md transition-all hover:opacity-95 flex items-center justify-center gap-2"
              style="background: linear-gradient(135deg, #9333ea, #6b21a8);"
            >
              <span>2. Opt-in on Google Play</span>
              <span class="text-sm">↗</span>
            </a>
            <div class="text-[11px] text-center mt-2 font-mono" style="color: var(--color-text-muted);">
              play.google.com/apps/testing
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="p-6 sm:p-8 rounded-2xl border flex flex-col justify-between relative transition-all hover:scale-[1.02] shadow-lg" style="background-color: var(--color-surface); border-color: var(--color-border);">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="w-9 h-9 rounded-xl font-extrabold text-sm flex items-center justify-center text-white bg-green-600 shadow-sm">3</span>
              <span class="text-xs font-semibold px-2 py-0.5 rounded border border-green-500/40 text-green-300 bg-green-500/10">Install App</span>
            </div>
            <h3 class="text-xl font-bold mb-2" style="color: var(--color-text-primary);">Install from Play Store</h3>
            <p class="text-xs sm:text-sm mb-6 leading-relaxed" style="color: var(--color-text-secondary);">
              Click the link below or open the Play Store app on your phone. You will now see the <strong>Install</strong> button enabled on your device!
            </p>
          </div>
          <div>
            <a
              href="https://play.google.com/store/apps/details?id=com.tekromancy.silentmodecontrol"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3 rounded-xl font-bold text-xs uppercase tracking-wider text-center text-white shadow-md transition-all hover:opacity-95 flex items-center justify-center gap-2 bg-gradient-to-r from-green-600 to-emerald-700"
            >
              <span>3. Download on Play Store</span>
              <span class="text-sm">↗</span>
            </a>
            <div class="text-[11px] text-center mt-2 font-mono" style="color: var(--color-text-muted);">
              Package: com.tekromancy.silentmodecontrol
            </div>
          </div>
        </div>
      </div>

      <!-- Feedback / Community Callout -->
      <div class="rounded-2xl p-6 border flex flex-col sm:flex-row items-center justify-between gap-4 text-xs shadow-sm" style="background-color: var(--color-surface); border-color: var(--color-border); color: var(--color-text-secondary);">
        <div class="flex items-center gap-3">
          <span class="text-2xl">💬</span>
          <div>
            <div class="font-bold text-sm" style="color: var(--color-text-primary);">Have feedback, questions, or bug reports?</div>
            <div>Post directly to the <a href="https://groups.google.com/g/tekromancy" target="_blank" rel="noopener noreferrer" class="underline font-semibold" style="color: var(--color-primary);">tekromancy Google Group</a> or email <a href="mailto:tekromancy@googlegroups.com" class="underline font-mono" style="color: var(--color-primary);">tekromancy@googlegroups.com</a>.</div>
          </div>
        </div>
        <a
          href="https://groups.google.com/g/tekromancy"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-xl font-bold border transition-colors hover:opacity-80 shrink-0"
          style="background-color: var(--color-surface-elevated); border-color: var(--color-border); color: var(--color-text-primary);"
        >
          Open Tester Group &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive 24-Hour Graphical Timeline Showcase -->
  <section id="timeline" class="py-20 border-b" style="border-color: var(--color-border); background-color: var(--color-surface);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="text-xs font-extrabold uppercase tracking-widest mb-3" style="color: var(--color-primary);">
          Visual Schedule Engine
        </h2>
        <h3 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4" style="color: var(--color-text-primary);">
          The 24-Hour Graphical Schedule Timeline
        </h3>
        <p class="text-base" style="color: var(--color-text-secondary);">
          Never wonder what mode your phone is in. Silent Mode Control renders an intuitive 24-hour timeline bar for any contact, group, or day of the week.
        </p>
      </div>

      <!-- Mock Timeline Interactive Component -->
      <div class="p-6 sm:p-8 rounded-3xl border shadow-xl max-w-4xl mx-auto" style="background-color: var(--color-surface-elevated); border-color: var(--color-border);">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b" style="border-color: var(--color-border);">
          <div>
            <div class="font-bold text-lg" style="color: var(--color-text-primary);">Daily Schedule: Weekdays (Mon - Fri)</div>
            <div class="text-xs" style="color: var(--color-text-secondary);">Simulated active contact: Family & Emergency VIPs</div>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-green-500 animate-ping"></span>
            <span class="text-xs font-mono font-bold" style="color: var(--color-text-primary);">14:35 Current Time</span>
          </div>
        </div>

        <!-- 24-Hour Bar -->
        <div class="relative w-full h-12 rounded-xl overflow-hidden flex shadow-inner border" style="border-color: var(--color-border);">
          <!-- 00:00 - 07:00 Mute -->
          <div class="h-full flex items-center justify-center text-[11px] font-bold text-white transition-opacity hover:opacity-90 cursor-help" style="width: 29.1%; background-color: #9333ea;" title="00:00 - 07:00: Silent / Mute">
            Silent (Night)
          </div>
          <!-- 07:00 - 09:00 Vibrate -->
          <div class="h-full flex items-center justify-center text-[11px] font-bold text-white transition-opacity hover:opacity-90 cursor-help" style="width: 8.3%; background-color: #ea580c;" title="07:00 - 09:00: Vibrate Only">
            Vibrate
          </div>
          <!-- 09:00 - 18:00 Ring & Vibrate -->
          <div class="h-full flex items-center justify-center text-[11px] font-bold text-white transition-opacity hover:opacity-90 cursor-help" style="width: 37.5%; background-color: #16a34a;" title="09:00 - 18:00: Ring & Vibrate (Work Hours)">
            Ring & Vibrate (Day)
          </div>
          <!-- 18:00 - 22:00 Ring Only -->
          <div class="h-full flex items-center justify-center text-[11px] font-bold text-white transition-opacity hover:opacity-90 cursor-help" style="width: 16.7%; background-color: #2563eb;" title="18:00 - 22:00: Ring Only (Evening)">
            Ring
          </div>
          <!-- 22:00 - 24:00 Mute -->
          <div class="h-full flex items-center justify-center text-[11px] font-bold text-white transition-opacity hover:opacity-90 cursor-help" style="width: 8.4%; background-color: #9333ea;" title="22:00 - 24:00: Silent / Mute">
            Mute
          </div>
        </div>

        <!-- 24-Hour Markers -->
        <div class="flex justify-between text-[11px] font-mono mt-2" style="color: var(--color-text-secondary);">
          <span>00:00</span>
          <span>04:00</span>
          <span>08:00</span>
          <span>12:00</span>
          <span>16:00</span>
          <span>20:00</span>
          <span>24:00</span>
        </div>

        <!-- Timeline Mode Legend with Icons -->
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mt-8 pt-6 border-t" style="border-color: var(--color-border);">
          <div class="flex items-center gap-2 text-xs font-semibold" style="color: var(--color-text-primary);">
            <img src="/icons/mode-ring-vibrate.svg" alt="Ring & Vibrate" class="w-4 h-4" />
            <span>Ring & Vibrate</span>
          </div>
          <div class="flex items-center gap-2 text-xs font-semibold" style="color: var(--color-text-primary);">
            <img src="/icons/mode-ring-only.svg" alt="Ring Only" class="w-4 h-4" />
            <span>Ring Only</span>
          </div>
          <div class="flex items-center gap-2 text-xs font-semibold" style="color: var(--color-text-primary);">
            <img src="/icons/mode-vibrate-only.svg" alt="Vibrate Only" class="w-4 h-4" />
            <span>Vibrate Only</span>
          </div>
          <div class="flex items-center gap-2 text-xs font-semibold" style="color: var(--color-text-primary);">
            <img src="/icons/mode-silent.svg" alt="Silent / Mute" class="w-4 h-4" />
            <span>Silent / Mute</span>
          </div>
          <div class="flex items-center gap-2 text-xs font-semibold" style="color: var(--color-text-primary);">
            <img src="/icons/mode-block.svg" alt="Block / Reject" class="w-4 h-4" />
            <span>Block / Reject</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Features Grid -->
  <section id="features" class="py-24 border-b" style="border-color: var(--color-border);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-xs font-extrabold uppercase tracking-widest mb-3" style="color: var(--color-primary);">
          Engineered for Android
        </h2>
        <h3 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4" style="color: var(--color-text-primary);">
          Precision Control for Busy Lives
        </h3>
        <p class="text-base" style="color: var(--color-text-secondary);">
          Everything you need to orchestrate incoming calls without unwanted distractions.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="p-8 rounded-3xl border transition-all hover:scale-[1.02] hover:shadow-lg flex flex-col justify-between" style="background-color: var(--color-surface); border-color: var(--color-border);">
          <div>
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-6 font-bold text-xl text-white shadow" style="background: linear-gradient(135deg, #9333ea, #7e22ce);">
              ⚡
            </div>
            <h4 class="text-xl font-bold mb-3" style="color: var(--color-text-primary);">Individual Number Precedence</h4>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-secondary);">
              Individual contact schedules always override group rules. Give VIPs or doctors personal bypass schedules regardless of what group they belong to.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t text-xs font-semibold" style="border-color: var(--color-border); color: var(--color-primary);">
            Zero Rule Conflicts
          </div>
        </div>

        <!-- Feature 2 -->
        <div class="p-8 rounded-3xl border transition-all hover:scale-[1.02] hover:shadow-lg flex flex-col justify-between" style="background-color: var(--color-surface); border-color: var(--color-border);">
          <div>
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-6 font-bold text-xl text-white shadow" style="background: linear-gradient(135deg, #2563eb, #1d4ed8);">
              👥
            </div>
            <h4 class="text-xl font-bold mb-3" style="color: var(--color-text-primary);">Smart Contact Groups</h4>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-secondary);">
              Organize phone numbers into Family, Work, School, or Contractor groups. Configure a shared schedule rule once, and apply it to every member instantly.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t text-xs font-semibold" style="border-color: var(--color-border); color: var(--color-primary);">
            Effortless Bulk Management
          </div>
        </div>

        <!-- Feature 3 -->
        <div class="p-8 rounded-3xl border transition-all hover:scale-[1.02] hover:shadow-lg flex flex-col justify-between" style="background-color: var(--color-surface); border-color: var(--color-border);">
          <div>
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-6 font-bold text-xl text-white shadow" style="background: linear-gradient(135deg, #16a34a, #15803d);">
              🛡️
            </div>
            <h4 class="text-xl font-bold mb-3" style="color: var(--color-text-primary);">Telecom Call Screening</h4>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-secondary);">
              Leverages official Android 10+ Telecom CallScreeningService. Runs only during incoming calls with zero background battery consumption.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t text-xs font-semibold" style="border-color: var(--color-border); color: var(--color-primary);">
            Native OS Performance
          </div>
        </div>

        <!-- Feature 4 -->
        <div class="p-8 rounded-3xl border transition-all hover:scale-[1.02] hover:shadow-lg flex flex-col justify-between" style="background-color: var(--color-surface); border-color: var(--color-border);">
          <div>
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-6 font-bold text-xl text-white shadow" style="background: linear-gradient(135deg, #ea580c, #c2410c);">
              🧪
            </div>
            <h4 class="text-xl font-bold mb-3" style="color: var(--color-text-primary);">Live Rule Simulator</h4>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-secondary);">
              Test any number against any simulated date and time. Watch the real-time decision path trace through individual overrides, group policies, and default fallbacks.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t text-xs font-semibold" style="border-color: var(--color-border); color: var(--color-primary);">
            Complete Confidence Before Calls
